DATABASE_URL=
AUTH_SECRET=
CREDENTIALS_KEY=
OWNER_ACCESS_CODE=
EVE_SERVICE_TOKEN=
CRON_SECRET=
# Gateway uses Vercel OIDC on deployment; local tokens come from vercel env pull.
